{
  "expo": {
    "name": "De Woordenaar",
    "slug": "dutch-learning-app",
    "description": "AI-powered Dutch vocabulary learning app with spaced repetition system",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icons/ios-light.png",
    "scheme": "dutchlearning",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/icons/splash-icon-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./src/assets/icons/splash-icon-dark.png",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "bundleIdentifier": "com.oldrefery.dutch-learning-app",
      "buildNumber": "78",
      "icon": "./src/assets/icons/ios-light.png",
      "infoPlist": {
        "UIBackgroundModes": [],
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "7FQ395U52U"
    },
    "android": {
      "versionCode": 78,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.oldrefery.dutchlearningapp",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "dutchlearning"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "plugins": [
      "./plugins/withRCTTurboModulePatch",
      "expo-router",
      "expo-updates",
      "expo-sqlite",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-apple-authentication",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "dutch-learning-app",
          "organization": "oldrefery"
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/icons/splash-icon-light.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./src/assets/icons/splash-icon-dark.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true,
            "useFrameworks": "dynamic"
          }
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/d968536e-1e9b-4224-9ed7-a1e9c6d821c8",
      "enableBsdiffPatchSupport": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d968536e-1e9b-4224-9ed7-a1e9c6d821c8"
      }
    },
    "owner": "oldrefery"
  }
}
