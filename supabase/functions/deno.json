{
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2",
    "../../packages/domain/src/shared-dictionary": "../../packages/domain/src/shared-dictionary.ts",
    "@std/assert": "https://deno.land/std@0.224.0/assert/mod.ts"
  },
  "compilerOptions": {
    "lib": ["deno.window"],
    "strict": true
  },
  "lock": {
    "path": "./deno.lock",
    "frozen": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": true,
    "proseWrap": "preserve"
  }
}
