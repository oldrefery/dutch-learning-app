# Template only. Loading this file keeps the endpoint disabled.
# Supabase supplies these three server credentials in a hosted function.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

DICTIONARY_CREATION_ENDPOINT_ENABLED=false
DICTIONARY_CREATION_GEMINI_API_KEY=
DICTIONARY_CREATION_GENERATION_MODEL=
DICTIONARY_CREATION_GENERATION_MODEL_VERSION=
DICTIONARY_CREATION_JUDGEMENT_MODEL=
DICTIONARY_CREATION_JUDGEMENT_MODEL_VERSION=
# Bind to the separately reviewed buildCreationGeminiProfile output.
DICTIONARY_CREATION_POLICY_SHA256=
DICTIONARY_CREATION_PROMPT_SHA256=
# Explicit JSON array of browser origins; [] allows native calls only.
DICTIONARY_CREATION_ALLOWED_ORIGINS=[]
