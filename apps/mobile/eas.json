{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "node": "24.20.0",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Debug"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "node": "24.20.0",
      "distribution": "internal",
      "channel": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "node": "24.20.0",
      "autoIncrement": false,
      "environment": "production",
      "channel": "production",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "development-simulator": {
      "node": "24.20.0",
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "environment": "development"
    },
    "e2e-test": {
      "node": "24.20.0",
      "withoutCredentials": true,
      "distribution": "internal",
      "env": {
        "WOORDENAAR_QA_BUILD": "true",
        "EXPO_PUBLIC_E2E_TEST_MODE": "true"
      },
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "dictionary-release": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_DICTIONARY_CONTENT_ENABLED": "true",
        "EXPO_PUBLIC_DICTIONARY_FOLLOWING_ENABLED": "true",
        "EXPO_PUBLIC_DICTIONARY_FOLLOWING_IMPORTS_ENABLED": "true",
        "EXPO_PUBLIC_DICTIONARY_SHARED_ANALYSIS_ENABLED": "true",
        "WOORDENAAR_QA_BUILD": "false",
        "EXPO_PUBLIC_E2E_TEST_MODE": "false",
        "EXPO_PUBLIC_DEV_USER_EMAIL": "disabled@example.invalid",
        "EXPO_PUBLIC_DEV_USER_ID": "00000000-0000-0000-0000-000000000000",
        "EXPO_PUBLIC_DEV_USER_PASSWORD": "disabled"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "7FQ395U52U",
        "ascAppId": "6752469146"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "dictionary-release": {
      "extends": "production",
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
