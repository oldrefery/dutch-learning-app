{
  "name": "@woordenaar/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:turbopack": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "node e2e/credential-preflight.mjs && playwright test --project=chromium --project=mobile-chromium",
    "test:e2e:smoke": "node e2e/credential-preflight.mjs && playwright test --project=chromium --grep @smoke",
    "test:e2e:extended": "node e2e/credential-preflight.mjs && playwright test --project=chromium --project=mobile-chromium --grep @extended",
    "test:e2e:cross-browser": "playwright test --project=firefox --project=webkit",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:install:all": "playwright install chromium firefox webkit"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.72.0",
    "@supabase/ssr": "0.9.0",
    "@supabase/supabase-js": "2.98.0",
    "@woordenaar/content": "*",
    "@woordenaar/domain": "*",
    "@woordenaar/supabase-contracts": "*",
    "lucide-react": "^1.41.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
